# Supabase (all apps)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Trading server URL (browser → EC2 WebSocket)
NEXT_PUBLIC_WS_URL=wss://your-ec2-ip:8080

# EC2 server only
CHAINLINK_RPC_URL=https://mainnet.infura.io/v3/your-key
PORT=8080

# Internal server URL (Next.js API routes → EC2)
SERVER_INTERNAL_URL=http://localhost:8080
